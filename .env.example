# Smart PO & Invoice Auditor Environment Configuration
HOST=0.0.0.0
PORT=8000
DB_PATH=enterprise.db

# ==============================================================================
# OpenAI-Compatible LLM Configuration (รองรับ OpenAI, vLLM, Ollama, OpenRouter, Groq, DeepSeek)
# ==============================================================================

# 1. API Key ของบริการ LLM ที่ต้องการใช้งาน (เช่น sk-... หรือ api key จากผู้ให้บริการ)
# หากปล่อยว่างไว้ ระบบจะใช้ Built-in Local Engine อัตโนมัติ
LLM_API_KEY=

# 2. Base URL ของ Endpoint ที่รองรับ OpenAI Format (ต้องลงท้ายด้วย /v1)
# ตัวอย่าง:
# - OpenAI Official : https://api.openai.com/v1
# - OpenRouter      : https://openrouter.ai/api/v1
# - Groq            : https://api.groq.com/openai/v1
# - DeepSeek        : https://api.deepseek.com/v1
# - Ollama (Local)  : http://localhost:11434/v1
# - vLLM (Local)    : http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1

# 3. Model Name ที่ต้องการเรียกใช้งาน
# ตัวอย่าง:
# - OpenAI     : gpt-4o-mini, gpt-4o
# - OpenRouter : openai/gpt-4o-mini, deepseek/deepseek-chat, qwen/qwen-2.5-72b-instruct
# - Groq       : llama-3.3-70b-versatile
# - Ollama     : qwen2.5:14b, llama3.1
LLM_MODEL=gpt-4o-mini

# 4. Temperature (ความแน่นอนในการสกัดข้อมูล แนะนำ 0.0)
LLM_TEMPERATURE=0.0

